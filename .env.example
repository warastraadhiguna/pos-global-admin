# pos-admin SELALU disajikan dari server yang sama dgn API-nya (lihat
# server/src/app.js), jadi path RELATIF ("/api") sudah benar utk semua
# kasus — otomatis ikut host/IP apa pun yang dipakai browser buat buka
# halaman ini. Jangan diganti ke URL absolut kecuali pos-admin memang
# di-hosting terpisah dari server (di luar setup default project ini).
VITE_API_BASE_URL=/api
